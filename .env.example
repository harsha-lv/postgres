# Database Connection Settings
# Option 1: Full connection URI (takes priority if specified)
# DATABASE_URL=postgresql://harsha:qwe@localhost:5432/top_users

# Option 2: Individual connection parameters
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=harsha
PGDATABASE=top_users
PGPASSWORD=qwe

# Alternative environment variable names (also supported):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=harsha
# DB_PASSWORD=qwe
# DB_NAME=top_users

# Application Port
PORT=3000
